        "step1",
        "step2"
      ],
      "title": "Sequence",
      "type": "object"
    },
    "SolutionJoin": {
      "description": "Specify what to do with solutions produced in parallel for a same channel.",
      "enum": [
        "MultipleValue",
        "List",
        "First",
        "Arbitration"
      ],
      "title": "SolutionJoin",
      "type": "string"
    },
    "Statement": {
      "description": "Statements that act on data or on logs.",
      "properties": {
        "log": {
          "title": "Log",
          "type": "string"
        }
      },
      "required": [
        "log"
      ],
      "title": "Statement",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "accumulate-loop": "#/$defs/AccumulateLoop",
      "algorithmic-step": "#/$defs/AlgorithmicStep",
      "generation-step": "#/$defs/GenerationStep",
      "parallel-build": "#/$defs/ParallelBuild",
      "parallel-eval": "#/$defs/ParallelEvaluation",
      "reply-step": "#/$defs/ReplyStep",
      "retry-loop": "#/$defs/RetryUntilValidated",
      "sequence": "#/$defs/Sequence"
