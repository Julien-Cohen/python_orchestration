          "items": {
            "discriminator": {
              "mapping": {
                "accumulate-loop": "#/$defs/AccumulateLoop",
                "algorithmic-step": "#/$defs/AlgorithmicStep",
                "generation-step": "#/$defs/GenerationStep",
                "parallel-build": "#/$defs/ParallelBuild",
