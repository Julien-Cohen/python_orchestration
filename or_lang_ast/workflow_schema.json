    },
    {
      "$ref": "#/$defs/RetryUntilValidated"
    },
    {
      "$ref": "#/$defs/AccumulateLoop"
    },
    {
      "$ref": "#/$defs/ParallelBuild"
    },
    {
      "$ref": "#/$defs/ParallelEvaluation"
    },
    {
      "$ref": "#/$defs/ReplyStep"
    }
  ]
}