              "$ref": "#/$defs/AccumulateLoop"
            },
            {
              "$ref": "#/$defs/ParallelBuild"
            },
            {
              "$ref": "#/$defs/ParallelEvaluation"
            },
            {
              "$ref": "#/$defs/ReplyStep"
            }
          ],
          "title": "Body"
        }
      },
      "required": [
        "condition",
        "body"
      ],
      "title": "RetryUntilValidated",
      "type": "object"
    },
    "Sequence": {
      "properties": {
        "type": {
          "const": "sequence",
          "default": "sequence",
          "title": "Type",
          "type": "string"
