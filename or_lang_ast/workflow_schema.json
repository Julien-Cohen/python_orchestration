          "title": "Skill",
          "type": "string"
        },
        "nbSpawns": {
          "title": "Nbspawns",
          "type": "integer"
        },
        "nbDifferentAgents": {
          "title": "Nbdifferentagents",
          "type": "integer"
        },
        "nbRequiredAnswers": {
          "title": "Nbrequiredanswers",
          "type": "integer"
        },
        "agentTimeout": {
          "title": "Agenttimeout",
          "type": "integer"
        },
        "onAgentFailure": {
          "$ref": "#/$defs/OnAgentFailure"
        },
        "onAgentRejection": {
          "$ref": "#/$defs/OnAgentFailure"
