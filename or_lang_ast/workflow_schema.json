            "oneOf": [
              {
                "$ref": "#/$defs/Sequence"
              },
              {
                "$ref": "#/$defs/AlgorithmicStep"
              },
              {
                "$ref": "#/$defs/GenerationStep"
              },
              {
                "$ref": "#/$defs/RetryUntilValidated"
              },
              {
                "$ref": "#/$defs/AccumulateLoop"
              },
              {
                "$ref": "#/$defs/ParallelBuild"
              },
              {
                "$ref": "#/$defs/ParallelEvaluation"
              },
              {
                "$ref": "#/$defs/ReplyStep"
              }
            ]
          },
          "title": "Branches",
          "type": "array"
        },
        "reconciliation": {
          "$ref": "#/$defs/DecisionMode"
        }
      },
      "required": [
        "branches",
        "reconciliation"
      ],
      "title": "ParallelEvaluation",
      "type": "object"
    },
    "ReplyStep": {
      "properties": {
        "type": {
          "const": "reply-step",
          "default": "reply-step",
          "title": "Type",
          "type": "string"
        },
