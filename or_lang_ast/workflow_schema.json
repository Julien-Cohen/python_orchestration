    "ChannelDeclaration": {
      "description": "A channel contains the data that is read or written by agents.\nThe name of a channel must be unique.\nIt is initialized once at the beginning of an orchestration.",
      "properties": {
        "type": {
          "const": "channel-declaration",
          "default": "channel-declaration",
          "title": "Type",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "structure": {
          "$ref": "#/$defs/ChannelStructure"
        },
        "init": {
          "title": "Init",
          "type": "string"
        }
      },
      "required": [
        "name",
        "structure",
        "init"
      ],
      "title": "ChannelDeclaration",
      "type": "object"
    },
