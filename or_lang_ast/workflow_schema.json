            "mapping": {
              "accumulate-loop": "#/$defs/AccumulateLoop",
              "algorithmic-step": "#/$defs/AlgorithmicStep",
              "evaluation-step": "#/$defs/EvaluationStep",
              "generation-step": "#/$defs/GenerationStep",
              "parallel-build": "#/$defs/ParallelBuild",
              "parallel-eval": "#/$defs/ParallelEvaluation",
              "reply-step": "#/$defs/ReplyStep",
              "retry-loop": "#/$defs/RetryUntilValidated",
              "sequence": "#/$defs/Sequence"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Sequence"
            },
            {
              "$ref": "#/$defs/AlgorithmicStep"
